# Editor defaults for codegym, aligned with rubocop-rails-omakase.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown deliberately keeps the global trim. The usual reason to exempt it is
# two-space hard line breaks, which nothing in this repo uses. Stray trailing
# spaces in docs/decisions are what prompted this file (207bbe5), so exempting
# Markdown would defeat the point.
[*.md]
trim_trailing_whitespace = true

# Encrypted credentials are generated, never hand-edited. An editor appending a
# final newline to the payload risks breaking decryption, so leave it alone.
[*.enc]
insert_final_newline = false
trim_trailing_whitespace = false
