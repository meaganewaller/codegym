<% content_for :title, "Exercises" %>

<header class="masthead">
  <h1>codegym</h1>
  <p class="tagline">Pick an exercise. Turn the agent off. Start the timer.</p>

  <% unless signed_in? %>
    <p class="sign-in-prompt">
      <%= link_to "Sign in with GitHub", sign_in_path %> to keep track of which
      exercises you have done and how long they took.
    </p>
  <% end %>
</header>

<%# turbo_action: "advance" is what makes a filter click push the new URL, so
    the filter survives a refresh, a bookmark and the back button. The chips
    live inside the frame so they re-render with the list and can show which one
    is active. %>
<%= turbo_frame_tag "library", data: { turbo_action: "advance" } do %>
  <%= render "filters" %>
  <%= render "list", exercises: @exercises %>
<% end %>
